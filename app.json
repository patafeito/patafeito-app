{
  "expo": {
    "name": "Patafeito",
    "slug": "patafeito",
    "scheme": "patafeito",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#10233A",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ianfelps.patafeito"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "@react-native-vector-icons/ionicons",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "31614aac-7e58-4992-9de6-3b5f78d80960"
      }
    },
    "owner": "ianfelps"
  }
}
