# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# --- Só para o EAS (este arquivo substitui o .gitignore no upload) ---

# Arte-fonte: os scripts `sprites`, `shop-assets` e `brand` geram a partir dela
# os arquivos que o app carrega (assets/pets/frames, assets/shop, banner-prepared).
/assets/cenarios/
/assets/pets/*.png
/assets/banner.png
/assets/comidas.png
/assets/moedas.png
/assets/poderes.png

# Documentação e scripts de desenvolvimento não entram no build.
/docs/
/scripts/
