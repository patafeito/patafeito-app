# Sem este arquivo, o app usa o IP do computador que serve o bundle Expo na porta 3000.
# Defina apenas se a API estiver em outro endereço.

# Aparelho físico com `adb reverse tcp:3000 tcp:3000` (contorna firewall do Windows):
# EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Emulador Android sem adb reverse:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1

# Apenas a porta, mantendo a detecção automática do host:
# EXPO_PUBLIC_API_PORT=3000
